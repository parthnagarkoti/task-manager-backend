# ─────────────────────────────────────────────────────────────────
# .env.example — Safe to commit. Shows required environment variables.
# Copy this file to .env and fill in your own values.
# The .env file is in .gitignore and will NEVER be committed.
# ─────────────────────────────────────────────────────────────────

# MySQL credentials
DB_USERNAME=taskuser
DB_PASSWORD=yourpassword
DB_ROOT_PASSWORD=yourrootpassword

# JWT secret — must be at least 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=replace-this-with-a-long-random-secret-key-min-32-chars
